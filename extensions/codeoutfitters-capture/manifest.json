{
  "manifest_version": 3,
  "name": "CodeOutfitters Meeting Capture",
  "version": "0.1.0",
  "description": "Captures active Google Meet tab audio into CodeOutfitters after explicit user consent.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "tabCapture", "offscreen", "identity", "storage", "alarms"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/*",
    "https://*.webex.com/*"
  ],
  "optional_host_permissions": [
    "http://localhost:3005/*",
    "https://codeoutfitters.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.zoom.us/*", "https://*.webex.com/*"],
      "js": ["contracts.js", "providers.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeOutfitters Meeting Capture"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
